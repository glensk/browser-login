#!/bin/bash
# secret-run — the installed entry point (root-owned, LIBEXEC/current/bin/).
#
# /usr/local/bin/secret-run is a root-owned symlink to this file (install.sh).
# It runs the installed client with the installed venv's interpreter in
# isolated mode (-I: no PYTHON* env vars, no user site-packages, no script dir
# on sys.path), so nothing an agent can write is imported. `secret-run -h`
# shows the usage; the client is bin/secret_run.py.
set -euo pipefail

LIBEXEC="/usr/local/libexec/login-broker"
PY="${LIBEXEC}/current/venv/bin/python"
CLIENT="${LIBEXEC}/current/bin/secret_run.py"

if [[ ! -x "$PY" || ! -r "$CLIENT" ]]; then
	printf '❌ secret-run: the login broker is not installed (no %s)\n' "$CLIENT" >&2
	exit 125
fi
exec "$PY" -I "$CLIENT" "$@"
