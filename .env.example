# browser-login configuration — all optional.
#
# browser.py reads these from the *process environment* (os.environ), so for the
# ones that affect login you must EXPORT them in your shell (e.g. ~/.zshrc), not
# only place them in a repo .env. Copy to .env for local convenience if you like
# (.env is gitignored). NEVER put secrets here — only names/paths/labels.

# --- claude.ai (anthropic) full-auto magic-link login ---
# Your claude.ai login email. When set AND `himalaya` is configured to read that
# mailbox, `browser.py login anthropic` is fully automatic (no password, no code):
# it triggers the magic-link email, reads it, and opens the link. If unset, login
# falls back to ASSISTED (you complete the email login in the window once).
# Must be EXPORTED in the shell — browser.py reads the live environment.
# ANTHROPIC_LOGIN_EMAIL=you@example.com

# Who may send the magic-link mail. Only a login-looking mail from one of these
# senders is ever opened (anyone can forge the SUBJECT; mail.anthropic.com is
# covered by DMARC p=reject, so a forged From is dropped by Gmail/Exchange).
# Comma-separated; each entry is an exact address (no-reply@mail.anthropic.com)
# or an exact domain (mail.anthropic.com or @mail.anthropic.com) — no subdomain
# or suffix matching. Unset = the default below. ANY invalid entry disables
# auto-login (it falls back to assisted) instead of guessing what you meant.
# Must be EXPORTED in the shell.
# ANTHROPIC_LOGIN_MAIL_SENDERS=mail.anthropic.com

# --- shared browser ---
# Chrome DevTools Protocol (CDP) port the shared Chromium listens on (default 9222).
# CLAUDE_BROWSER_CDP_PORT=9222

# Seconds a Playwright attach (open/eval/doctor/login/token) may take before
# browser.py gives up and names the tab that blocks it (default 30; invalid or
# <= 0 falls back to 30). Playwright's own default would be 180 s.
# CLAUDE_BROWSER_CONNECT_TIMEOUT_S=30

# Hard deadline (seconds) of every unattended `browser.py login`: when it fires,
# the tabs the login opened are closed and browser.py exits 124 (125 when that
# cleanup is unconfirmed). Default 300; invalid, <= 0, NaN or inf falls back to
# 300. agent-login's runner kills browser.py at this value + 90 s. Never applied
# to a guided login (agent-login.py -g SITE).
# CLAUDE_BROWSER_LOGIN_TIMEOUT_S=300

# Host → proxy map for the shared browser's proxy auto-config (PAC). Unset = the
# committed bin/pac_hosts.json (groups.epfl.ch via the EPFL SOCKS5 proxy of
# `vpn.sh epflproxy`). Same JSON shape: {"host": "SOCKS5 127.0.0.1:1081"}; a
# leading dot (".epfl.ch") also matches subdomains; {} disables the PAC. Every
# unlisted host goes DIRECT. Read at `browser.py up` only — restart to apply
# (`browser.py down` then `browser.py up`).
# CLAUDE_BROWSER_PAC_HOSTS=~/.config/claude-browser/pac_hosts.json

# TEST-ONLY: move every coordination file (client registry, interaction lease,
# lifecycle record, profile) away from ~/.cache/claude-browser. The test suite
# sets it so it never touches the live browser's state. Never set it in a shell.
# CLAUDE_BROWSER_CACHE_DIR=/tmp/some-test-dir

# --- CSCS (cscs) unattended Keycloak login ---
# 1Password account + item used as the credential fallback (Touch-ID gated) before
# the macOS keychain is populated. Defaults: my.1password.com / "CSCS".
# CSCS_OP_ACCOUNT=my.1password.com
# CSCS_OP_ITEM=CSCS

# macOS-keychain *service-name* labels (NOT secrets) under which `store-creds cscs`
# saves the username / password / TOTP seed. Defaults shown; override only if they
# collide with existing keychain items.
# CSCS_KEYCHAIN_USER=cscs-api: username
# CSCS_KEYCHAIN_PASS=cscs-api: password
# CSCS_KEYCHAIN_TOTP=cscs-api: totp-seed
